DEBUG=True
SECRET_KEY=change-this-in-production-secret-key-shelsea-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Database Configuration (PostgreSQL in production, SQLite fallback in dev if DB_ENGINE=sqlite)
DB_ENGINE=sqlite
DB_NAME=shelsea_db
DB_USER=shelsea_user
DB_PASSWORD=shelsea_password
DB_HOST=localhost
DB_PORT=5432

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=

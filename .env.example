CLOUDINARY_API_SECRET=

# Resend Email Service
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Chelsea Coiffure <contact@shelsea-coiffure.fr>
ADMIN_EMAIL=chelsea@shelsea-coiffure.fr

# Booking safeguards
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_MAX_DAYS_AHEAD=60
BOOKING_RATE_LIMIT_PER_HOUR=8
LOGIN_RATE_LIMIT_PER_HOUR=12
